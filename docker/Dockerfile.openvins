# OpenVINS on ROS 1 Noetic / Ubuntu 20.04, following docs.openvins.com/gs-installing.
#
# OV_REF is pinned to an exact upstream commit. A moving branch makes every
# "regression" ambiguous: was it our harness or their commit? Changing the pin is a
# deliberate, reviewed change (tests/test_dockerfile_pin.py enforces a full SHA).
#   93adc241390d13e99232652cf05cbe18a93c7bea = tag v2.7 (2023-06-19), verified to build.
FROM osrf/ros:noetic-desktop-full
ARG OV_REF=93adc241390d13e99232652cf05cbe18a93c7bea
ENV DEBIAN_FRONTEND=noninteractive

# Apt packages from the install guide (Ceres from apt, as the guide recommends first).
RUN apt-get update && apt-get install -y --no-install-recommends \
      git build-essential python3-catkin-tools python3-osrf-pycommon \
      libeigen3-dev libboost-all-dev libceres-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws
# Fetch exactly one commit (no full history) and fail the build if HEAD != OV_REF.
RUN mkdir -p src/open_vins && cd src/open_vins \
    && git init -q && git remote add origin https://github.com/rpng/open_vins.git \
    && git fetch -q --depth 1 origin ${OV_REF} && git checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${OV_REF}" \
    && git rev-parse HEAD > /ws/OV_COMMIT && rm -rf .git

# -j4 matches the 4-core Codespace and keeps peak RAM well under 16 GB.
# build/ and logs/ are removed in the same layer; devel/ holds the binaries and libs.
RUN . /opt/ros/noetic/setup.sh \
    && catkin init \
    && catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && catkin build -j4 --no-status --summarize \
    && rm -rf build logs

# org.opencontainers.image.source links the GHCR package to THIS repo (S5b); the upstream
# OpenVINS source is recorded separately.
LABEL org.opencontainers.image.source="https://github.com/amirpourshafiee/vio-regress" \
      vioreg.ov_upstream="https://github.com/rpng/open_vins" \
      vioreg.ov_ref="${OV_REF}"
RUN printf '#!/bin/bash\nsource /opt/ros/noetic/setup.bash\nsource /ws/devel/setup.bash\nexec "$@"\n' \
      > /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
